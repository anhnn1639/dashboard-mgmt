{
    servers {
        strict_sni_host on
    }
}

http://{$OPS_DOMAIN} {
    redir https://{host}{uri} permanent
}

https://{$OPS_DOMAIN} {
    tls internal
    encode zstd gzip

    @agentEnroll path /api/v1/enroll
    handle @agentEnroll {
        reverse_proxy api:8000
    }

    @fileUpload path_regexp fileUpload ^/api/v1/servers/[^/]+/files/?$
    handle @fileUpload {
        request_body {
            # Includes multipart framing in addition to the 50 MiB file limit.
            max_size 55MB
        }
        reverse_proxy api:8000
    }

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /guacamole/* {
        reverse_proxy guacamole:8080
    }

    handle {
        reverse_proxy dashboard:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}

https://{$OPS_DOMAIN}:9443 {
    tls internal {
        client_auth {
            mode require_and_verify
            trust_pool file /etc/caddy/pki/agent-ca.crt
        }
    }

    @agent path /api/v1/agent/*
    handle @agent {
        reverse_proxy api:8000 {
            header_up -Authorization
            stream_close_delay 5m
        }
    }

    respond "Not found" 404
}
