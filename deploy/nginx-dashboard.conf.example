# Render this template with deploy/configure-nginx.sh. It is included inside
# nginx's http {} context on Ubuntu.

map $http_upgrade $tram_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __OPS_DOMAIN__;
    return 301 https://__OPS_DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __OPS_DOMAIN__;

    # Use a publicly trusted certificate here so a fresh Windows/Linux agent
    # can validate the initial HTTPS bootstrap without a preinstalled private CA.
    ssl_certificate __PUBLIC_CERTIFICATE__;
    ssl_certificate_key __PUBLIC_CERTIFICATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TramOpsSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    server_tokens off;

    client_max_body_size 1100m;

    location / {
        proxy_pass https://127.0.0.1:3000;
        proxy_hide_header Server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tram_connection_upgrade;

        # Caddy still encrypts and authenticates the local Nginx -> Caddy hop.
        proxy_ssl_server_name on;
        proxy_ssl_name __OPS_DOMAIN__;
        proxy_ssl_trusted_certificate __CADDY_CA_CERTIFICATE__;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_session_reuse on;

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 15s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_redirect off;
    }
}
