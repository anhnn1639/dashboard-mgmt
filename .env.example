OPS_DOMAIN=ops.example.com
# Caddy web entrypoint is published only on loopback for the host Nginx.
WEB_BIND_PORT=3000
# Use public/system-trusted TLS on Nginx for zero-touch bootstrap over 443.
# Agent operations on 9443 still use the dedicated internal mTLS CA.
WEB_TLS_TRUST=system
POSTGRES_USER=tramops
POSTGRES_DB=tramops
POSTGRES_PASSWORD=replace-with-32-random-characters
# Used only with compose.external.yaml. Percent-encode special characters in
# the username/password portion of the URL.
EXTERNAL_DATABASE_URL=postgresql+psycopg://tramops:replace-me@postgres.example.com:5432/tramops?sslmode=require
# Optional legacy/unattended override when running compose.yaml directly.
DATABASE_URL=
# Recommended when port 443 is reachable before setup is complete. Operators
# must enter this one-time deployment value in the setup wizard.
# Required before the first setup; use at least 32 random characters.
SETUP_TOKEN=replace-with-a-long-random-setup-token
# JWT_SECRET and JOB_SECRET_KEY are generated by the setup wizard and stored in
# the protected api_config Docker volume. They may still be supplied here for
# unattended deployments.
JWT_SECRET=
JOB_SECRET_KEY=
# Exactly 32 random hexadecimal characters (128-bit), required by Guacamole JSON auth.
GUACAMOLE_JSON_SECRET=0123456789abcdef0123456789abcdef
# Host path for native Guacamole recordings. In production, use an absolute
# path outside the repository/container, for example /srv/tram-ops/recordings.
RECORDING_DIR=./recordings
# Numeric group granted read-only recording access inside API and Guacamole.
# Keep 1000 for the pinned guacd 1.6.0 image unless the storage policy requires another shared GID.
RECORDING_GID=1000

# Public issuing CA certificates (*.crt) trusted by the isolated web browser.
# TLS and hostname verification remain required for internal consoles.
WEB_CONSOLE_CA_DIR=./deploy/web-console-ca
