OPS_DOMAIN=ops.example.com
ACME_EMAIL=admin@example.com
POSTGRES_USER=tramops
POSTGRES_DB=tramops
POSTGRES_PASSWORD=replace-with-32-random-characters
JWT_SECRET=replace-with-64-random-characters
# URL-safe base64-encoded 32-byte key used to encrypt secret job parameters.
JOB_SECRET_KEY=replace-with-a-fernet-key
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Exactly 32 random hexadecimal characters (128-bit), required by Guacamole JSON auth.
GUACAMOLE_JSON_SECRET=0123456789abcdef0123456789abcdef
