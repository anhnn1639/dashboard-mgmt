OPS_DOMAIN=ops.example.com
ACME_EMAIL=admin@example.com
POSTGRES_USER=tramops
POSTGRES_DB=tramops
POSTGRES_PASSWORD=replace-with-32-random-characters
# Leave DATABASE_URL empty to use the first-run setup wizard. Set it only for
# unattended/legacy deployments; the wizard otherwise stores it in api_config.
DATABASE_URL=
# Recommended when port 443 is reachable before setup is complete. Operators
# must enter this one-time deployment value in the setup wizard.
SETUP_TOKEN=replace-with-a-long-random-setup-token
# JWT_SECRET and JOB_SECRET_KEY are generated by the setup wizard and stored in
# the protected api_config Docker volume. They may still be supplied here for
# unattended deployments.
JWT_SECRET=
JOB_SECRET_KEY=
# Exactly 32 random hexadecimal characters (128-bit), required by Guacamole JSON auth.
GUACAMOLE_JSON_SECRET=0123456789abcdef0123456789abcdef
